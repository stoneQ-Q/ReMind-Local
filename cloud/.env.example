REMIND_POSTGRES_DB=remind
REMIND_POSTGRES_USER=remind
REMIND_POSTGRES_PASSWORD=replace-with-a-long-random-local-password
REMIND_DB_PORT=5432
REMIND_BACKUP_INTERVAL_SECONDS=86400
REMIND_BACKUP_RETENTION_DAYS=7
# 生产部署设置为跨版本保留的绝对路径；本地开发留空即可。
REMIND_BACKUP_HOST_DIR=
REMIND_CREDENTIAL_KEY_VERSION=local-v1
REMIND_CREDENTIAL_KEY_BASE64=replace-with-32-random-bytes-encoded-as-base64
REMIND_CREDENTIAL_KEY_RING_JSON=
# 默认为本地私有卷；创建私有 COS 桶和最小权限子账号后才能改为 tencent_cos。
REMIND_OBJECT_STORE_PROVIDER=local
REMIND_COS_BUCKET=
REMIND_COS_REGION=ap-hongkong
REMIND_COS_SECRET_ID=
REMIND_COS_SECRET_KEY=
# 仅使用临时密钥时填写；固定子账号密钥留空。
REMIND_COS_SECURITY_TOKEN=
REMIND_MEDIA_PROVIDER=disabled
# 仅在完成平台密钥、价格和成本验证后改为 remote。
REMIND_MANAGED_ZHIPU_API_KEY=
REMIND_MANAGED_DEEPSEEK_API_KEY=
REMIND_PRICE_ZHIPU_VISION_PER_IMAGE_MICROS=
REMIND_PRICE_ZHIPU_ASR_PER_MINUTE_MICROS=
REMIND_PRICE_DEEPSEEK_INPUT_PER_MILLION_TOKENS_MICROS=
REMIND_PRICE_DEEPSEEK_OUTPUT_PER_MILLION_TOKENS_MICROS=
