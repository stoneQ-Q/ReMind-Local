{
  "name": "remind-wechat-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:raw": "wrangler dev --ip 0.0.0.0",
    "service:check": "node scripts/dev-local.mjs --check",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply remind-wechat --local",
    "db:migrate:remote": "wrangler d1 migrations apply remind-wechat --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
